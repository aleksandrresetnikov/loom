        <mxCell id="e6label" value="вызов" style="text;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#ffffff;fontSize=18;fontFamily=Arial;align=center;verticalAlign=middle;" vertex="1" parent="1">
