        </mxCell>
        <mxCell id="n3" value="VirtualMachine&#10;Стек и кадры вызова" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=#202020;strokeWidth=2;fillColor=#eef3f8;fontColor=#202020;fontSize=24;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
