        </mxCell>
        <mxCell id="n4" value="NativeCallBridge&#10;Проверка и преобразование&#10;LoomValue" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=#202020;strokeWidth=2;fillColor=#fffef1;fontColor=#202020;fontSize=22;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
